# ---------------------------------------------------------
# DeliveryLink Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ---------------------------------------------------------

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deliverylink
DB_USER=deliverylink_app
DB_PASSWORD=change_me_strong_password
DB_POOL_MAX=20
DB_SSL=false

# Redis (caching, rate-limit store, pub/sub for live tracking)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Firebase (Auth, FCM push notifications, Storage)
FIREBASE_PROJECT_ID=deliverylink-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@deliverylink-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=deliverylink-prod.appspot.com

# Google Maps Platform
GOOGLE_MAPS_API_KEY=replace_with_real_key
GOOGLE_DIRECTIONS_API_KEY=replace_with_real_key
GOOGLE_DISTANCE_MATRIX_API_KEY=replace_with_real_key

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TEMP_DIR=./tmp/uploads

# Logging
LOG_LEVEL=info
